@model Gym_Management_Webapp.Models.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập - GymPro Fitness & Club";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    
    <!-- Google Fonts & Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    
    <!-- Tailwind CSS with Custom GymPro Theme -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#9d4300",
                        "primary-container": "#f97316",
                        "primary-fixed": "#ffdbca",
                        "primary-fixed-dim": "#ffb690",
                        "on-primary": "#ffffff",
                        "on-primary-container": "#582200",
                        "secondary": "#565e74",
                        "secondary-container": "#dae2fd",
                        "on-secondary-container": "#5c647a",
                        "background": "#f7f9fb",
                        "surface": "#f7f9fb",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#f2f4f6",
                        "surface-container": "#eceef0",
                        "surface-container-high": "#e6e8ea",
                        "surface-container-highest": "#e0e3e5",
                        "on-surface": "#191c1e",
                        "on-surface-variant": "#584237",
                        "error": "#ba1a1a",
                        "error-container": "#ffdad6",
                        "on-error-container": "#93000a"
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "2xl": "1rem",
                        "full": "9999px"
                    },
                    fontFamily: {
                        "body": ["Inter", "sans-serif"],
                        "display": ["Plus Jakarta Sans", "sans-serif"]
                    },
                    spacing: {
                        "space-xs": "0.25rem",
                        "space-sm": "0.5rem",
                        "space-md": "1rem",
                        "space-lg": "1.5rem",
                        "space-xl": "2.5rem",
                        "gutter": "1.5rem"
                    }
                }
            }
        };
    </script>
    <style>
        ::-webkit-scrollbar { display: none; }
    </style>
</head>
<body class="bg-background font-body text-on-surface min-h-screen flex flex-col antialiased">

    <!-- Top Navigation Header -->
    <header class="fixed top-0 left-0 right-0 z-50 bg-surface-container-lowest/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)]">
        <div class="h-16 max-w-7xl mx-auto px-gutter flex items-center justify-between gap-space-md">
            <!-- Brand Logo -->
            <div class="flex items-center gap-space-md">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-space-sm text-decoration-none">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-primary to-primary-container flex items-center justify-center text-white shadow-md">
                        <span class="material-symbols-outlined text-[24px]">fitness_center</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="font-display text-xl font-extrabold text-on-surface leading-none tracking-tight">GymPro</span>
                        <span class="text-[11px] text-on-surface-variant font-medium uppercase tracking-wider">Fitness &amp; Club</span>
                    </div>
                </a>
            </div>

            <!-- Navigation Links -->
            <nav class="hidden md:flex items-center gap-space-lg">
                <a asp-controller="Home" asp-action="Index" class="text-sm font-semibold text-on-surface-variant hover:text-primary transition-colors">Trang chủ</a>
                <a asp-controller="Account" asp-action="Login" class="text-sm font-bold text-primary border-b-2 border-primary pb-0.5">Đăng nhập</a>
                <a asp-controller="Account" asp-action="Register" class="text-sm font-semibold text-on-surface-variant hover:text-primary transition-colors">Đăng ký hội viên</a>
            </nav>

            <!-- Quick Contacts & Hotline -->
            <div class="flex items-center gap-space-md">
                <div class="hidden sm:flex items-center gap-space-xs text-on-surface-variant bg-surface-container px-space-sm py-space-xs rounded-full text-xs">
                    <span class="material-symbols-outlined text-[16px] text-primary-container">call</span>
                    <span class="font-semibold text-on-surface">1900 6868</span>
                </div>
                <a asp-controller="Account" asp-action="Register" class="h-9 px-4 rounded-lg bg-primary hover:bg-on-primary-container text-white text-xs font-bold transition-all shadow-sm flex items-center gap-1">
                    <span class="material-symbols-outlined text-[16px]">how_to_reg</span>
                    <span>Đăng ký</span>
                </a>
            </div>
        </div>
    </header>

    <!-- Main Container (Split Bento Auth Card) -->
    <main class="flex-1 w-full pt-20 pb-12 flex flex-col justify-center items-center px-4 md:px-8">
        <div class="w-full max-w-6xl mx-auto my-auto">
            
            <!-- Breadcrumbs -->
            <div class="flex items-center gap-space-xs mb- space-md text-xs text-on-surface-variant font-medium">
                <a asp-controller="Home" asp-action="Index" class="hover:text-primary transition-colors flex items-center gap-1">
                    <span class="material-symbols-outlined text-[15px]">home</span>
                    Trang chủ
                </a>
                <span>/</span>
                <span class="text-on-surface font-semibold">Tài Khoản</span>
                <span>/</span>
                <span class="text-primary-container font-semibold">Đăng Nhập</span>
            </div>

            <!-- Main Auth Bento Container (Split Screen) -->
            <div class="w-full bg-surface-container-lowest rounded-2xl shadow-2xl overflow-hidden grid grid-cols-1 lg:grid-cols-12 min-h-[640px] border border-surface-container">
                
                <!-- Left Column: Visual Showcase & Brand Slogan (5 cols) -->
                <div class="lg:col-span-5 relative flex flex-col justify-between p-space-lg lg:p-space-xl text-white overflow-hidden min-h-[400px] lg:min-h-full">
                    <!-- Background Image -->
                    <div class="absolute inset-0 bg-cover bg-center transition-transform duration-700 hover:scale-105" 
                         style="background-image: url('https://images.unsplash.com/photo-1534438327276-14e5300c3a48?q=80&w=1200&auto=format&fit=crop');"></div>
                    
                    <!-- Dynamic Gradients Overlay -->
                    <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/80 to-slate-900/40 mix-blend-multiply"></div>
                    <div class="absolute inset-0 bg-gradient-to-br from-primary/40 via-transparent to-black/80"></div>

                    <!-- Upper Content: Brand & Tagline -->
                    <div class="relative z-10">
                        <div class="inline-flex items-center gap-space-xs px-3 py-1 rounded-full bg-white/15 backdrop-blur-md mb-space-md">
                            <span class="w-2 h-2 rounded-full bg-primary-container animate-pulse"></span>
                            <span class="text-[11px] uppercase tracking-wider text-white font-semibold">GymPro System v2.4</span>
                        </div>
                        <h2 class="font-display text-3xl lg:text-4xl font-extrabold tracking-tight text-white leading-tight mb-space-xs">
                            Nâng Tầm Thể Lực<br />
                            <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-300 to-orange-500">
                                Bứt Phá Giới Hạn
                            </span>
                        </h2>
                        <p class="text-xs lg:text-sm text-slate-200/90 max-w-sm leading-relaxed">
                            Nền tảng quản lý hội viên, phòng tập và lịch huấn luyện chuyên nghiệp theo tiêu chuẩn quốc tế.
                        </p>
                    </div>

                    <!-- Middle Content: High-impact Metric Highlights -->
                    <div class="relative z-10 my-space-md space-y-space-sm">
                        <div class="flex items-center gap-space-sm p-3 rounded-xl bg-white/10 backdrop-blur-md transition-all hover:bg-white/20">
                            <div class="w-10 h-10 rounded-lg bg-primary-container/25 flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-orange-300 text-[22px]">fitness_center</span>
                            </div>
                            <div>
                                <div class="text-xs font-bold text-white">500+ Thiết bị Technogym</div>
                                <div class="text-[11px] text-slate-300">Nhập khẩu từ Ý, bảo trì định kỳ</div>
                            </div>
                        </div>

                        <div class="flex items-center gap-space-sm p-3 rounded-xl bg-white/10 backdrop-blur-md transition-all hover:bg-white/20">
                            <div class="w-10 h-10 rounded-lg bg-primary-container/25 flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-orange-300 text-[22px]">sports_martial_arts</span>
                            </div>
                            <div>
                                <div class="text-xs font-bold text-white">HLV Cá Nhân Chuyên Nghiệp</div>
                                <div class="text-[11px] text-slate-300">Chứng chỉ quốc tế NASM, ACE</div>
                            </div>
                        </div>

                        <div class="flex items-center gap-space-sm p-3 rounded-xl bg-white/10 backdrop-blur-md transition-all hover:bg-white/20">
                            <div class="w-10 h-10 rounded-lg bg-primary-container/25 flex items-center justify-center shrink-0">
                                <span class="material-symbols-outlined text-orange-300 text-[22px]">qr_code_scanner</span>
                            </div>
                            <div>
                                <div class="text-xs font-bold text-white">Hệ Thống Check-in QR Thông Minh</div>
                                <div class="text-[11px] text-slate-300">Kiểm soát ra vào tự động 0.3s</div>
                            </div>
                        </div>
                    </div>

                    <!-- Lower Footnote: Status Indicator -->
                    <div class="relative z-10 flex items-center justify-between pt-space-sm border-t border-white/10 text-xs text-slate-300">
                        <div class="flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
                            <span>EF Core Database Connected</span>
                        </div>
                        <span class="font-mono text-[11px] opacity-80">AccountController.cs</span>
                    </div>
                </div>

                <!-- Right Column: Authentication Form Container (7 cols) -->
                <div class="lg:col-span-7 p-space-lg lg:p-space-xl flex flex-col justify-between bg-surface-container-lowest">
                    <div>
                        <!-- Segmented Switcher & Tech Pill -->
                        <div class="flex items-center justify-between mb-space-lg">
                            <div class="inline-flex p-1 bg-surface-container rounded-xl">
                                <span class="px-space-md py-1.5 rounded-lg bg-surface-container-lowest text-on-surface font-semibold text-xs shadow-sm">
                                    Đăng nhập
                                </span>
                                <a asp-controller="Account" asp-action="Register" class="px-space-md py-1.5 rounded-lg text-on-surface-variant hover:text-on-surface font-medium text-xs transition-all">
                                    Đăng ký hội viên
                                </a>
                            </div>

                            <span class="hidden sm:inline-flex items-center gap-1.5 text-xs text-secondary bg-secondary-container/40 px-3 py-1 rounded-full font-medium">
                                <span class="w-2 h-2 rounded-full bg-primary-container"></span>
                                ASP.NET Core MVC 10
                            </span>
                        </div>

                        <!-- Section Heading -->
                        <div class="mb-space-md">
                            <h1 class="font-display text-2xl lg:text-3xl font-bold text-on-surface tracking-tight">
                                Chào mừng trở lại! 👋
                            </h1>
                            <p class="text-xs sm:text-sm text-on-surface-variant mt-1">
                                Đăng nhập vào hệ thống quản lý GymPro để tiếp tục buổi tập hoặc ca làm việc của bạn.
                            </p>
                        </div>

                        <!-- Success message after registration -->
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="mb-space-md p-3 bg-emerald-50 text-emerald-900 rounded-xl flex items-center justify-between border-l-4 border-emerald-500 shadow-sm">
                                <div class="flex items-center gap-2 text-xs sm:text-sm font-medium">
                                    <span class="material-symbols-outlined text-emerald-600 text-[20px]">check_circle</span>
                                    <span>@TempData["SuccessMessage"]</span>
                                </div>
                                <button type="button" onclick="this.parentElement.remove()" class="text-emerald-700 hover:text-emerald-950">
                                    <span class="material-symbols-outlined text-[18px]">close</span>
                                </button>
                            </div>
                        }

                        <!-- Server Validation Error Alert -->
                        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                        {
                            <div class="mb-space-md p-3 bg-error-container/60 rounded-xl flex items-start gap-space-sm border-l-4 border-error text-on-error-container" id="aspValidationSummary">
                                <span class="material-symbols-outlined text-error text-[20px] shrink-0 mt-0.5">error</span>
                                <div class="text-xs sm:text-sm flex-1">
                                    <div class="font-bold text-error">Đăng nhập không thành công</div>
                                    @foreach (var error in ViewData.ModelState[string.Empty]!.Errors)
                                    {
                                        <p class="text-[13px] leading-relaxed mt-0.5 mb-0">@error.ErrorMessage</p>
                                    }
                                </div>
                                <button type="button" onclick="document.getElementById('aspValidationSummary').style.display='none'" class="text-on-error-container opacity-70 hover:opacity-100">
                                    <span class="material-symbols-outlined text-[18px]">close</span>
                                </button>
                            </div>
                        }

                        <!-- Real MVC Login Form -->
                        <form asp-controller="Account" asp-action="Login" method="post" class="space-y-4" id="loginForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" asp-for="ReturnUrl" />

                            <!-- Field 1: Username -->
                            <div>
                                <div class="flex items-center justify-between mb-1.5">
                                    <label class="text-xs font-semibold text-on-surface" asp-for="TenDangNhap">
                                        Tên đăng nhập <span class="text-error font-bold">*</span>
                                    </label>
                                    <span class="text-[11px] text-on-surface-variant font-mono">TenDangNhap</span>
                                </div>
                                <div class="relative flex items-center">
                                    <div class="absolute left-3.5 text-secondary flex items-center pointer-events-none">
                                        <span class="material-symbols-outlined text-[20px]">person</span>
                                    </div>
                                    <input asp-for="TenDangNhap" 
                                           class="w-full h-11 pl-10 pr-10 bg-surface-container-low text-on-surface rounded-xl text-sm placeholder:text-on-surface-variant/50 focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary-container transition-all border border-transparent focus:border-primary-container" 
                                           placeholder="Nhập tên đăng nhập (ví dụ: admin, user)..." 
                                           required 
                                           autocomplete="username" 
                                           id="TenDangNhap" />
                                </div>
                                <span asp-validation-for="TenDangNhap" class="mt-1 text-xs text-error font-medium block"></span>
                            </div>

                            <!-- Field 2: Password -->
                            <div>
                                <div class="flex items-center justify-between mb-1.5">
                                    <label class="text-xs font-semibold text-on-surface" asp-for="MatKhau">
                                        Mật khẩu <span class="text-error font-bold">*</span>
                                    </label>
                                    <span class="text-[11px] text-on-surface-variant font-mono">MatKhau</span>
                                </div>
                                <div class="relative flex items-center">
                                    <div class="absolute left-3.5 text-secondary flex items-center pointer-events-none">
                                        <span class="material-symbols-outlined text-[20px]">lock</span>
                                    </div>
                                    <input asp-for="MatKhau" 
                                           type="password" 
                                           class="w-full h-11 pl-10 pr-11 bg-surface-container-low text-on-surface rounded-xl text-sm placeholder:text-on-surface-variant/50 focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary-container transition-all border border-transparent focus:border-primary-container" 
                                           placeholder="••••••••" 
                                           required 
                                           autocomplete="current-password" 
                                           id="MatKhau" />
                                    <button type="button" aria-label="Hiện/ẩn mật khẩu" class="absolute right-3 text-on-surface-variant hover:text-on-surface flex items-center p-1 focus:outline-none" id="togglePasswordBtn">
                                        <span class="material-symbols-outlined text-[20px]" id="togglePasswordIcon">visibility</span>
                                    </button>
                                </div>
                                <span asp-validation-for="MatKhau" class="mt-1 text-xs text-error font-medium block"></span>
                            </div>

                            <!-- Role & Auth Info Note -->
                            <div class="p-3 rounded-xl bg-surface-container-low flex items-start gap-space-sm text-on-surface-variant text-xs leading-relaxed">
                                <span class="material-symbols-outlined text-[18px] text-primary-container shrink-0 mt-0.5">account_tree</span>
                                <div>
                                    Hệ thống tự động phân quyền theo <strong class="text-on-surface">Vai trò (Admin / Hội viên)</strong> dựa trên CSDL SQL Server &amp; cấp Cookie Authentication bảo mật.
                                </div>
                            </div>

                            <!-- Options Row: Remember Me & Forgot Password -->
                            <div class="flex items-center justify-between pt-1">
                                <label class="flex items-center gap-2 cursor-pointer select-none">
                                    <input asp-for="GhiNho" class="w-4 h-4 rounded text-primary-container focus:ring-primary-container cursor-pointer accent-orange-600" />
                                    <span class="text-xs font-medium text-on-surface">Ghi nhớ đăng nhập</span>
                                </label>
                                <a href="#" class="text-xs text-primary font-semibold hover:underline">
                                    Quên mật khẩu?
                                </a>
                            </div>

                            <!-- Submit Action Button -->
                            <button type="submit" class="w-full h-12 bg-primary-container hover:bg-orange-600 text-white text-sm font-bold rounded-xl shadow-md hover:shadow-lg flex items-center justify-center gap-2 transition-all duration-200 group active:scale-[0.99] mt-2">
                                <span>ĐĂNG NHẬP NGAY</span>
                                <span class="material-symbols-outlined text-[18px] transition-transform duration-200 group-hover:translate-x-1">arrow_forward</span>
                            </button>
                        </form>
                    </div>

                    <!-- Developer / Testing Helper Cards -->
                    <div class="mt-6 pt-4 border-t border-surface-container-highest">
                        <div class="flex items-center justify-between mb-2">
                            <span class="text-[11px] font-bold uppercase text-secondary tracking-wider flex items-center gap-1">
                                <span class="material-symbols-outlined text-[15px]">bug_report</span>
                                Tài khoản mẫu trong CSDL (Click để điền tự động):
                            </span>
                            <span class="text-[11px] text-on-surface-variant font-mono">1-click fill</span>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            <!-- Admin Credential Card -->
                            <button type="button" class="text-left p-2.5 rounded-xl bg-surface-container hover:bg-surface-container-high transition-colors flex items-center justify-between group cursor-pointer border border-transparent hover:border-orange-300" id="fillAdminBtn">
                                <div class="flex items-center gap-2">
                                    <span class="w-7 h-7 rounded-lg bg-orange-100 text-orange-700 flex items-center justify-center font-bold text-xs">AD</span>
                                    <div>
                                        <div class="text-xs font-bold text-on-surface">Admin Quản trị</div>
                                        <div class="text-[11px] text-on-surface-variant font-mono">admin / admin123</div>
                                    </div>
                                </div>
                                <span class="material-symbols-outlined text-[16px] text-on-surface-variant group-hover:text-primary transition-colors">input</span>
                            </button>

                            <!-- Member Credential Card -->
                            <button type="button" class="text-left p-2.5 rounded-xl bg-surface-container hover:bg-surface-container-high transition-colors flex items-center justify-between group cursor-pointer border border-transparent hover:border-blue-300" id="fillMemberBtn">
                                <div class="flex items-center gap-2">
                                    <span class="w-7 h-7 rounded-lg bg-blue-100 text-blue-700 flex items-center justify-center font-bold text-xs">HV</span>
                                    <div>
                                        <div class="text-xs font-bold text-on-surface">Hội viên Gym</div>
                                        <div class="text-[11px] text-on-surface-variant font-mono">user / user123</div>
                                    </div>
                                </div>
                                <span class="material-symbols-outlined text-[16px] text-on-surface-variant group-hover:text-primary transition-colors">input</span>
                            </button>
                        </div>

                        <!-- Bottom Micro-footer -->
                        <div class="mt-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-on-surface-variant">
                            <div>
                                Chưa có tài khoản hội viên? 
                                <a asp-controller="Account" asp-action="Register" class="font-bold text-primary hover:underline">Đăng ký ngay</a>
                            </div>
                            <div class="flex items-center gap-1 text-[11px] text-secondary">
                                <span class="material-symbols-outlined text-[14px]">lock</span>
                                <span>Mã hóa Cookie &amp; Session an toàn</span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="w-full bg-surface-container-lowest border-t border-surface-container py-4">
        <div class="max-w-7xl mx-auto px-gutter flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-on-surface-variant text-center sm:text-left">
            <p class="mb-0">© 2026 GymPro Fitness &amp; Club Management - ASP.NET Core MVC &amp; EF Core</p>
            <div class="flex items-center gap-3">
                <a href="#" class="hover:text-primary transition-colors">Điều khoản dịch vụ</a>
                <span>•</span>
                <a href="#" class="hover:text-primary transition-colors">Chính sách bảo mật</a>
                <span>•</span>
                <a href="#" class="hover:text-primary transition-colors">Hỗ trợ kỹ thuật</a>
            </div>
        </div>
    </footer>

    <!-- Micro-interactions Script -->
    <script>
        (function() {
            // Show/Hide Password
            const toggleBtn = document.getElementById('togglePasswordBtn');
            const passInput = document.getElementById('MatKhau');
            const passIcon = document.getElementById('togglePasswordIcon');
            const usernameInput = document.getElementById('TenDangNhap');

            if (toggleBtn && passInput && passIcon) {
                toggleBtn.addEventListener('click', function() {
                    const isPassword = passInput.getAttribute('type') === 'password';
                    passInput.setAttribute('type', isPassword ? 'text' : 'password');
                    passIcon.textContent = isPassword ? 'visibility_off' : 'visibility';
                });
            }

            // Quick Auto-fill buttons for demonstration/grading
            const adminBtn = document.getElementById('fillAdminBtn');
            const memberBtn = document.getElementById('fillMemberBtn');

            if (adminBtn && usernameInput && passInput) {
                adminBtn.addEventListener('click', function() {
                    usernameInput.value = 'admin';
                    passInput.value = 'admin123';
                    highlightInput();
                });
            }

            if (memberBtn && usernameInput && passInput) {
                memberBtn.addEventListener('click', function() {
                    usernameInput.value = 'user';
                    passInput.value = 'user123';
                    highlightInput();
                });
            }

            function highlightInput() {
                [usernameInput, passInput].forEach(el => {
                    el.classList.add('ring-2', 'ring-primary-container', 'bg-orange-50');
                    setTimeout(() => {
                        el.classList.remove('ring-2', 'ring-primary-container', 'bg-orange-50');
                    }, 400);
                });
            }
        })();
    </script>
</body>
</html>

@{
    Layout = null;
    ViewData["Title"] = "Tổng Quan & Thống Kê Quản Trị - GymPro Admin";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Google Fonts & Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

    <!-- Tailwind CSS with Custom Theme -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#9d4300",
                        "primary-container": "#f97316",
                        "primary-fixed": "#ffdbca",
                        "primary-fixed-dim": "#ffb690",
                        "on-primary": "#ffffff",
                        "on-primary-container": "#582200",
                        "secondary": "#565e74",
                        "secondary-container": "#dae2fd",
                        "secondary-fixed": "#dae2fd",
                        "secondary-fixed-dim": "#bec6e0",
                        "on-secondary-container": "#5c647a",
                        "tertiary": "#545f73",
                        "tertiary-container": "#909bb1",
                        "tertiary-fixed": "#d8e3fb",
                        "tertiary-fixed-dim": "#bcc7de",
                        "background": "#f7f9fb",
                        "surface": "#f7f9fb",
                        "surface-container-lowest": "#ffffff",
                        "surface-container-low": "#f2f4f6",
                        "surface-container": "#eceef0",
                        "surface-container-high": "#e6e8ea",
                        "surface-container-highest": "#e0e3e5",
                        "on-surface": "#191c1e",
                        "on-surface-variant": "#584237",
                        "outline": "#8c7164",
                        "outline-variant": "#e0c0b1",
                        "error": "#ba1a1a",
                        "error-container": "#ffdad6",
                        "on-error-container": "#93000a"
                    },
                    borderRadius: {
                        "DEFAULT": "0.25rem",
                        "lg": "0.5rem",
                        "xl": "0.75rem",
                        "full": "9999px"
                    },
                    fontFamily: {
                        "body": ["Inter", "sans-serif"],
                        "display": ["Plus Jakarta Sans", "sans-serif"]
                    },
                    spacing: {
                        "space-xs": "0.25rem",
                        "space-sm": "0.5rem",
                        "space-md": "1rem",
                        "space-lg": "1.5rem",
                        "space-xl": "2.5rem",
                        "gutter": "1.5rem"
                    }
                }
            }
        };
    </script>
    <style>
        ::-webkit-scrollbar { display: none; }
    </style>
</head>
<body class="bg-surface font-body text-on-surface antialiased">

    <!-- Fixed Left Sidebar (w-64) -->
    <aside class="fixed left-0 top-0 h-full w-64 bg-surface-container-lowest shadow-[0_1px_8px_rgba(0,0,0,0.04)] z-50 flex flex-col justify-between overflow-y-auto">
        <div class="flex flex-col">
            <!-- Brand Logo Header -->
            <div class="h-16 px-space-lg flex items-center gap-space-sm bg-surface-container-lowest shadow-[0_1px_8px_rgba(0,0,0,0.02)] border-b border-surface-container">
                <a asp-controller="Admin" asp-action="Index" class="flex items-center gap-2.5 text-decoration-none">
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-primary to-primary-container flex items-center justify-center text-white shadow-md">
                        <span class="material-symbols-outlined text-[22px]">fitness_center</span>
                    </div>
                    <div class="flex flex-col">
                        <span class="font-display text-lg font-bold text-on-surface tracking-tight leading-none">GymPro</span>
                        <span class="text-[10px] text-on-surface-variant font-medium mt-0.5 tracking-wider uppercase">Fitness &amp; Club</span>
                    </div>
                </a>
            </div>

            <!-- Group 1: TỔNG QUAN -->
            <div class="px-space-md py-space-sm">
                <div class="px-space-sm py-space-xs text-[11px] uppercase font-bold text-outline tracking-wider">TỔNG QUAN</div>
                <nav class="mt-1 space-y-1">
                    <a asp-controller="Admin" asp-action="Index" class="flex items-center gap-space-sm px-space-md py-2.5 bg-primary-container text-white font-semibold rounded-lg shadow-sm text-sm">
                        <span class="material-symbols-outlined text-[20px]">dashboard</span>
                        <span>Dashboard Thống kê</span>
                    </a>
                    <a asp-controller="Home" asp-action="Index" target="_blank" class="flex items-center gap-space-sm px-space-md py-2.5 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors text-sm">
                        <span class="material-symbols-outlined text-[20px]">open_in_new</span>
                        <span>Xem Trang Chủ Web</span>
                    </a>
                </nav>
            </div>

            <!-- Group 2: DANH MỤC & DỊCH VỤ -->
            <div class="px-space-md py-space-sm">
                <div class="px-space-sm py-space-xs text-[11px] uppercase font-bold text-outline tracking-wider">DANH MỤC &amp; DỊCH VỤ</div>
                <nav class="mt-1 space-y-1">
                    <a asp-controller="LoaiGoiTap" asp-action="Index" class="flex items-center gap-space-sm px-space-md py-2.5 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors text-sm">
                        <span class="material-symbols-outlined text-[20px]">category</span>
                        <span>Loại gói tập</span>
                    </a>
                    <a href="#" class="flex items-center gap-space-sm px-space-md py-2.5 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors text-sm">
                        <span class="material-symbols-outlined text-[20px]">fitness_center</span>
                        <span>Quản lý Gói tập</span>
                    </a>
                </nav>
            </div>

            <!-- Group 3: NGHIỆP VỤ HỘI VIÊN -->
            <div class="px-space-md py-space-sm">
                <div class="px-space-sm py-space-xs text-[11px] uppercase font-bold text-outline tracking-wider">NGHIỆP VỤ HỘI VIÊN</div>
                <nav class="mt-1 space-y-1">
                    <a href="#" class="flex items-center gap-space-sm px-space-md py-2.5 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors text-sm">
                        <span class="material-symbols-outlined text-[20px]">badge</span>
                        <span>Quản lý Hội viên</span>
                    </a>
                    <a href="#" class="flex items-center justify-between px-space-md py-2.5 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors text-sm">
                        <div class="flex items-center gap-space-sm">
                            <span class="material-symbols-outlined text-[20px]">assignment</span>
                            <span>Phiếu đăng ký</span>
                        </div>
                        <span class="text-xs bg-error-container text-on-error-container px-2 py-0.5 rounded-full font-bold">5</span>
                    </a>
                </nav>
            </div>

            <!-- Group 4: BÁO CÁO & HỆ THỐNG -->
            <div class="px-space-md py-space-sm">
                <div class="px-space-sm py-space-xs text-[11px] uppercase font-bold text-outline tracking-wider">BÁO CÁO &amp; HỆ THỐNG</div>
                <nav class="mt-1 space-y-1">
                    <a href="#" class="flex items-center gap-space-sm px-space-md py-2.5 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors text-sm">
                        <span class="material-symbols-outlined text-[20px]">bar_chart</span>
                        <span>Báo cáo doanh thu</span>
                    </a>
                    <a asp-controller="TaiKhoans" asp-action="Index" class="flex items-center justify-between px-space-md py-2.5 rounded-lg text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors text-sm">
                        <div class="flex items-center gap-space-sm">
                            <span class="material-symbols-outlined text-[20px]">admin_panel_settings</span>
                            <span>Tài khoản &amp; Quyền</span>
                        </div>
                        @if (ViewBag.TotalAccounts != null)
                        {
                            <span class="text-[11px] bg-surface-container-high text-on-surface px-2 py-0.5 rounded-full font-bold">@ViewBag.TotalAccounts</span>
                        }
                    </a>
                </nav>
            </div>
        </div>

        <!-- Sidebar Bottom: Logout Button -->
        <div class="p-space-md bg-surface-container-low shadow-[0_1px_8px_rgba(0,0,0,0.02)] border-t border-surface-container">
            <form asp-controller="Account" asp-action="Logout" method="post" class="w-full">
                @Html.AntiForgeryToken()
                <button type="submit" class="w-full flex items-center gap-space-sm px-space-md py-2.5 rounded-lg text-error hover:bg-error-container hover:text-on-error-container transition-colors text-sm font-semibold text-left">
                    <span class="material-symbols-outlined text-[20px]">logout</span>
                    <span>Đăng xuất</span>
                </button>
            </form>
        </div>
    </aside>

    <!-- Main Content Wrapper (pl-64 offset for sidebar) -->
    <div class="pl-64">
        <!-- Top Navbar Header -->
        <header class="fixed top-0 left-64 right-0 h-16 bg-surface-container-lowest/90 backdrop-blur-xl shadow-[0_1px_8px_rgba(0,0,0,0.04)] z-40 flex items-center justify-between px-space-lg border-b border-surface-container">
            <!-- Search Input -->
            <div class="flex items-center gap-space-md flex-1 max-w-xl">
                <div class="relative w-full">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[20px]">search</span>
                    <input class="w-full h-10 pl-10 pr-4 bg-surface-container-low rounded-lg text-sm text-on-surface placeholder:text-outline focus:outline-none focus:bg-surface-container-lowest shadow-sm transition-all border border-transparent focus:border-primary-container" 
                           placeholder="Tìm kiếm hội viên, mã gói, phiếu đăng ký..." type="text" />
                </div>
            </div>

            <!-- Top Header Right Actions -->
            <div class="flex items-center gap-space-md">
                <!-- Session Status Badge -->
                <div class="hidden xl:flex items-center gap-2 px-3 py-1.5 rounded-full bg-surface-container-high text-on-surface">
                    <span class="w-2 h-2 rounded-full bg-primary-container animate-pulse"></span>
                    <span class="text-xs font-medium">Session: <strong class="font-semibold text-primary">@User.Identity?.Name</strong> | Role: <strong class="font-semibold text-error">Admin</strong></span>
                </div>

                <!-- Create Registration Action Button -->
                <a href="#" class="inline-flex items-center gap-1.5 bg-primary-container hover:bg-primary text-white px-3.5 py-2 rounded-lg text-xs font-bold shadow-sm transition-colors">
                    <span class="material-symbols-outlined text-[18px]">add_circle</span>
                    <span>+ Tạo phiếu đăng ký</span>
                </a>

                <!-- Notification Bell -->
                <button class="relative p-2 rounded-lg hover:bg-surface-container-high text-on-surface-variant transition-colors" title="5 phiếu đăng ký chờ duyệt" type="button">
                    <span class="material-symbols-outlined text-[22px]">notifications</span>
                    <span class="absolute top-1.5 right-1.5 w-2.5 h-2.5 bg-error rounded-full ring-2 ring-surface-container-lowest"></span>
                </button>

                <!-- User Profile Dropdown info -->
                <div class="flex items-center gap-space-sm pl-2 border-l border-surface-container">
                    <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center text-white shadow-sm">
                        <span class="material-symbols-outlined text-[18px]">person</span>
                    </div>
                    <div class="hidden md:flex flex-col text-left">
                        <span class="text-xs font-bold text-on-surface leading-tight">@(User.Identity?.Name ?? "Quản trị viên")</span>
                        <span class="text-[11px] text-on-surface-variant leading-tight">Hệ thống GymPro</span>
                    </div>
                    <span class="material-symbols-outlined text-outline text-[18px]">expand_more</span>
                </div>
            </div>
        </header>

        <!-- Main Dashboard View Container -->
        <main class="relative pt-16 bg-surface min-h-[calc(100vh-3.5rem)]">
            <div class="p-space-lg lg:p-8 space-y-6 max-w-[1600px] mx-auto w-full">

                <!-- Breadcrumb & Administrative Header Bar -->
                <div class="flex flex-col md:flex-row md:items-center justify-between gap-space-md">
                    <div>
                        <nav class="flex items-center gap-1.5 text-xs text-outline mb-1">
                            <a asp-controller="Home" asp-action="Index" class="hover:text-primary-container transition-colors flex items-center gap-1">
                                <span class="material-symbols-outlined text-[15px]">home</span>
                                <span>Trang chủ</span>
                            </a>
                            <span>/</span>
                            <span>Admin</span>
                            <span>/</span>
                            <span class="text-on-surface font-semibold">Dashboard Thống Kê</span>
                        </nav>
                        <h1 class="font-display text-2xl lg:text-3xl font-extrabold text-on-surface tracking-tight">
                            Tổng Quan &amp; Thống Kê Quản Trị
                        </h1>
                    </div>

                    <!-- Quick Action Controls -->
                    <div class="flex flex-wrap items-center gap-2.5">
                        <div class="inline-flex items-center gap-1.5 bg-surface-container-low px-3 py-2 rounded-lg text-on-surface-variant text-xs font-semibold">
                            <span class="material-symbols-outlined text-[18px] text-outline">schedule</span>
                            <span id="liveClock">Đang tải ca làm việc...</span>
                        </div>
                        <div class="relative">
                            <select class="appearance-none bg-surface-container-lowest text-on-surface text-xs font-semibold pl-3.5 pr-8 py-2 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-primary-container cursor-pointer transition-all border border-surface-container">
                                <option>Tháng này (T10/2026)</option>
                                <option>Tuần này</option>
                                <option>Hôm nay</option>
                                <option>Quý IV / 2026</option>
                                <option>Cả năm 2026</option>
                            </select>
                            <span class="material-symbols-outlined absolute right-2 top-1/2 -translate-y-1/2 text-outline pointer-events-none text-[18px]">expand_more</span>
                        </div>
                        <button class="inline-flex items-center gap-1.5 bg-surface-container-highest hover:bg-surface-container text-on-surface px-3.5 py-2 rounded-lg text-xs font-bold shadow-sm transition-colors" type="button">
                            <span class="material-symbols-outlined text-[18px]">file_download</span>
                            <span>Xuất Báo cáo Excel</span>
                        </button>
                    </div>
                </div>

                <!-- Administrative Welcome & System Telemetry Card -->
                <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-surface-container-lowest via-surface-container-lowest to-orange-100/60 p-space-md lg:p-6 shadow-sm border border-surface-container">
                    <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-primary-container/10 rounded-full blur-3xl pointer-events-none"></div>
                    <div class="relative z-10 flex flex-col lg:flex-row lg:items-center justify-between gap-space-md">
                        <div class="space-y-1">
                            <div class="inline-flex items-center gap-2">
                                <span class="font-display text-xl font-bold text-on-surface">Xin chào @(User.Identity?.Name ?? "Quản trị viên")! 👋</span>
                                <span class="bg-primary-container/15 text-primary text-[11px] font-bold px-2 py-0.5 rounded-full uppercase tracking-wider">SuperAdmin Active</span>
                            </div>
                            <p class="text-xs sm:text-sm text-on-surface-variant max-w-2xl leading-relaxed">
                                Hệ thống phòng tập GymPro đang hoạt động tối ưu. Hôm nay có <strong class="text-primary font-semibold">18 phiếu đăng ký mới</strong> cần duyệt và <strong class="text-on-surface font-semibold">12 hội viên</strong> chạm ngưỡng gia hạn trong 7 ngày tới.
                            </p>
                        </div>
                        <!-- Tech Stack Telemetry Badges -->
                        <div class="flex flex-wrap items-center gap-2">
                            <div class="flex items-center gap-1.5 bg-surface-container-low px-3 py-1.5 rounded-md text-xs text-on-surface font-medium">
                                <span class="material-symbols-outlined text-[16px] text-primary-container">layers</span>
                                <span>ASP.NET Core 10 MVC</span>
                            </div>
                            <div class="flex items-center gap-1.5 bg-surface-container-low px-3 py-1.5 rounded-md text-xs text-on-surface font-medium">
                                <span class="material-symbols-outlined text-[16px] text-primary-container">database</span>
                                <span>EF Core 10.0</span>
                            </div>
                            <div class="flex items-center gap-1.5 bg-emerald-50 text-emerald-800 px-3 py-1.5 rounded-md text-xs font-medium border border-emerald-200">
                                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                <span>SQL Server LocalDB: OK (@(ViewBag.TotalAccounts ?? 4) Users)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 4 Top KPI Metric Cards -->
                <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-space-md">
                    <!-- KPI 1: Doanh Thu -->
                    <div class="bg-surface-container-lowest rounded-2xl p-5 shadow-sm relative overflow-hidden flex flex-col justify-between group hover:shadow-md transition-shadow border border-surface-container">
                        <div class="flex items-start justify-between">
                            <div>
                                <span class="text-xs font-bold uppercase tracking-wider text-outline">Tổng Doanh Thu Tháng</span>
                                <div class="font-display text-2xl font-extrabold text-on-surface mt-1 tracking-tight">
                                    148,500,000 <span class="text-base font-semibold text-outline">đ</span>
                                </div>
                            </div>
                            <div class="w-11 h-11 rounded-xl bg-orange-100 flex items-center justify-center text-primary-container group-hover:scale-105 transition-transform shadow-sm">
                                <span class="material-symbols-outlined text-[24px]">payments</span>
                            </div>
                        </div>
                        <div class="mt-4 pt-3 flex items-center justify-between border-t border-surface-container">
                            <div class="inline-flex items-center gap-1 text-emerald-700 text-xs font-bold">
                                <span class="material-symbols-outlined text-[16px]">trending_up</span>
                                <span>+18.4%</span>
                                <span class="font-normal text-on-surface-variant">so với T09</span>
                            </div>
                            <!-- Sparkline SVG -->
                            <svg class="w-16 h-6 text-primary-container" fill="none" viewBox="0 0 64 24">
                                <path d="M1 19L14 15L27 17L40 9L51 12L63 3" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"></path>
                            </svg>
                        </div>
                    </div>

                    <!-- KPI 2: Hội Viên Hoạt Động -->
                    <div class="bg-surface-container-lowest rounded-2xl p-5 shadow-sm relative overflow-hidden flex flex-col justify-between group hover:shadow-md transition-shadow border border-surface-container">
                        <div class="flex items-start justify-between">
                            <div>
                                <span class="text-xs font-bold uppercase tracking-wider text-outline">Hội Viên Đang Hoạt Động</span>
                                <div class="font-display text-2xl font-extrabold text-on-surface mt-1 tracking-tight">
                                    1,248 <span class="text-sm font-semibold text-outline">hội viên</span>
                                </div>
                            </div>
                            <div class="w-11 h-11 rounded-xl bg-blue-100 flex items-center justify-center text-secondary group-hover:scale-105 transition-transform shadow-sm">
                                <span class="material-symbols-outlined text-[24px]">groups</span>
                            </div>
                        </div>
                        <div class="mt-4 pt-3 flex items-center justify-between border-t border-surface-container">
                            <div class="inline-flex items-center gap-1 text-emerald-700 text-xs font-bold">
                                <span class="material-symbols-outlined text-[16px]">person_add</span>
                                <span>+32 mới</span>
                                <span class="font-normal text-on-surface-variant">tuần này</span>
                            </div>
                            <div class="flex -space-x-1.5 overflow-hidden">
                                <div class="w-6 h-6 rounded-full bg-primary-container text-white text-[10px] font-bold flex items-center justify-center ring-2 ring-white">NA</div>
                                <div class="w-6 h-6 rounded-full bg-secondary text-white text-[10px] font-bold flex items-center justify-center ring-2 ring-white">TM</div>
                                <div class="w-6 h-6 rounded-full bg-tertiary text-white text-[10px] font-bold flex items-center justify-center ring-2 ring-white">HN</div>
                            </div>
                        </div>
                    </div>

                    <!-- KPI 3: Phiếu Chờ Duyệt / Gia Hạn -->
                    <div class="bg-surface-container-lowest rounded-2xl p-5 shadow-sm relative overflow-hidden flex flex-col justify-between group hover:shadow-md transition-shadow border border-surface-container">
                        <div class="flex items-start justify-between">
                            <div>
                                <span class="text-xs font-bold uppercase tracking-wider text-outline">Phiếu Chờ Duyệt / Gia Hạn</span>
                                <div class="font-display text-2xl font-extrabold text-primary mt-1 tracking-tight">
                                    18 <span class="text-sm font-semibold text-outline">phiếu</span>
                                </div>
                            </div>
                            <div class="w-11 h-11 rounded-xl bg-red-100 flex items-center justify-center text-red-600 group-hover:scale-105 transition-transform shadow-sm">
                                <span class="material-symbols-outlined text-[24px]">assignment_late</span>
                            </div>
                        </div>
                        <div class="mt-4 pt-3 flex items-center justify-between border-t border-surface-container">
                            <span class="bg-error-container text-on-error-container text-[11px] font-bold px-2 py-0.5 rounded-full inline-flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-error animate-ping"></span>
                                Cần xử lý ngay
                            </span>
                            <a href="#" class="text-xs text-primary font-bold hover:underline inline-flex items-center gap-0.5">
                                <span>Mở duyệt</span>
                                <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                            </a>
                        </div>
                    </div>

                    <!-- KPI 4: Gói Tập Hoạt Động & Tải Sàn -->
                    <div class="bg-surface-container-lowest rounded-2xl p-5 shadow-sm relative overflow-hidden flex flex-col justify-between group hover:shadow-md transition-shadow border border-surface-container">
                        <div class="flex items-start justify-between">
                            <div>
                                <span class="text-xs font-bold uppercase tracking-wider text-outline">Gói Tập Đang Phục Vụ</span>
                                <div class="font-display text-2xl font-extrabold text-on-surface mt-1 tracking-tight">
                                    24 <span class="text-sm font-semibold text-outline">gói / 5 loại</span>
                                </div>
                            </div>
                            <div class="w-11 h-11 rounded-xl bg-surface-container-high flex items-center justify-center text-on-surface group-hover:scale-105 transition-transform shadow-sm">
                                <span class="material-symbols-outlined text-[24px]">fitness_center</span>
                            </div>
                        </div>

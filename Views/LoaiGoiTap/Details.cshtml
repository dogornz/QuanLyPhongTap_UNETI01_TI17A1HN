@model QuanLyPhongTap_UNETI01_TI17A1HN.Models.LoaiGoiTap

@{
    ViewData["Title"] = "Details";
    var relatedGoiTap = ViewBag.RelatedGoiTap as IEnumerable<QuanLyPhongTap_UNETI01_TI17A1HN.Models.GoiTap>;
}

<h1>Details</h1>

<div>
    <h4>LoaiGoiTap</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.MaLoaiGoi)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.MaLoaiGoi)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.TenLoaiGoi)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.TenLoaiGoi)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.MoTa)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.MoTa)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.TrangThai)
        </dt>
        <dd class="col-sm-9">
            @if (Model.TrangThai == "Active" || Model.TrangThai == "Unlock" || Model.TrangThai == "Hoạt động")
            {
                <span class="badge bg-success">@Model.TrangThai</span>
            }
            else
            {
                <span class="badge bg-secondary">@Model.TrangThai</span>
            }
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.SoGoiTrucThuoc)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.SoGoiTrucThuoc)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.NgayCapNhat)
        </dt>
        <dd class="col-sm-9">
            @Model.NgayCapNhat.ToString("dd/MM/yyyy HH:mm:ss")
        </dd>
    </dl>
</div>

@if (relatedGoiTap != null && relatedGoiTap.Any())
{
    <div class="mt-4">
        <h5>Danh sách Gói tập trực thuộc (@relatedGoiTap.Count())</h5>
        <table class="table table-bordered table-sm mt-2">
            <thead>
                <tr>
                    <th>Mã gói tập</th>
                    <th>Tên gói tập</th>
                    <th>Thời hạn</th>
                    <th>Đơn giá</th>
                    <th>Số buổi tối đa</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in relatedGoiTap)
                {
                    <tr>
                        <td>@g.MaGoiTap</td>
                        <td>@g.TenGoiTap</td>
                        <td>@g.ThoiHanThang</td>
                        <td>@g.DonGia.ToString("N0") VNĐ</td>
                        <td>@g.SoBuoiToiDa</td>
                        <td>@g.TrangThai</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model?.MaLoaiGoi">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>

@model QuanLyPhongTap_UNETI01_TI17A1HN.Models.LoaiGoiTap

@{
    ViewData["Title"] = "Delete";
    bool canDelete = ViewBag.CanDelete ?? true;
    int relatedCount = ViewBag.RelatedCount ?? 0;
    var relatedGoiTap = ViewBag.RelatedGoiTap as IEnumerable<QuanLyPhongTap_UNETI01_TI17A1HN.Models.GoiTap>;
}

<h1>Delete</h1>

@if (!canDelete)
{
    <div class="alert alert-danger" role="alert">
        <h5 class="alert-heading mb-1"><i class="bi bi-exclamation-triangle-fill"></i> Không thể xóa loại gói tập!</h5>
        <p class="mb-0">
            Loại gói tập <strong>@Model.TenLoaiGoi</strong> đang có <strong>@relatedCount</strong> gói tập trực thuộc liên quan. 
            Theo quy định ràng buộc toàn vẹn dữ liệu: <em>Không được xóa loại gói nếu việc xóa làm dữ liệu GoiTap liên quan không còn hợp lệ.</em>
        </p>
    </div>
}
else
{
    <h3>Are you sure you want to delete this?</h3>
}

<div>
    <h4>LoaiGoiTap</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.MaLoaiGoi)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.MaLoaiGoi)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.TenLoaiGoi)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.TenLoaiGoi)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.MoTa)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.MoTa)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.TrangThai)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.TrangThai)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.SoGoiTrucThuoc)
        </dt>
        <dd class="col-sm-9">
            @Html.DisplayFor(model => model.SoGoiTrucThuoc)
        </dd>

        <dt class="col-sm-3">
            @Html.DisplayNameFor(model => model.NgayCapNhat)
        </dt>
        <dd class="col-sm-9">
            @Model.NgayCapNhat.ToString("dd/MM/yyyy HH:mm:ss")
        </dd>
    </dl>

    @if (relatedGoiTap != null && relatedGoiTap.Any())
    {
        <div class="mt-3 mb-4">
            <h5>Các gói tập đang trực thuộc loại gói này:</h5>
            <ul class="list-group">
                @foreach (var g in relatedGoiTap)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span><strong>@g.MaGoiTap</strong> - @g.TenGoiTap (@g.ThoiHanThang)</span>
                        <span class="badge bg-secondary">@g.TrangThai</span>
                    </li>
                }
            </ul>
        </div>
    }

    @if (canDelete)
    {
        <form asp-action="Delete">
            <input type="hidden" asp-for="MaLoaiGoi" />
            <input type="submit" value="Delete" class="btn btn-danger" /> |
            <a asp-action="Index">Back to List</a>
        </form>
    }
    else
    {
        <div>
            <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
        </div>
    }
</div>

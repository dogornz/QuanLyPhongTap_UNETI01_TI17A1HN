@using QuanLyPhongTap_UNETI01_TI17A1HN.Services
@model QuanLyPhongTap_UNETI01_TI17A1HN.Models.MemberDashboardViewModel
@{
    ViewData["Title"] = "Trang chủ";
    var isAuthenticated = User.Identity != null && User.Identity.IsAuthenticated;
    var isAdmin = isAuthenticated && (User.IsInRole("Admin") || User.IsInRole("admin"));
    var hoTenHienThi = Model.HoiVien?.HoTen ?? Model.TaiKhoan?.HoTen ?? User.Identity?.Name ?? "Hội viên";
    var homeReturnUrl = Url.Action("Index", "Home") ?? "/";
}

@Html.AntiForgeryToken()

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm mt-2" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm mt-2" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!isAuthenticated)
{
    <div class="alert alert-info shadow-sm mt-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            Chào mừng bạn đến với hệ thống <strong>Quản lý phòng tập UNETI</strong>! Vui lòng đăng nhập hoặc đăng ký tài khoản hội viên để đăng ký và theo dõi gói tập.
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm px-3">Đăng nhập</a>
            <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-sm px-3">Đăng ký</a>
        </div>
    </div>
}
else if (isAdmin)
{
    <div class="alert alert-warning shadow-sm mt-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            Bạn đang đăng nhập với quyền <strong>Quản trị viên</strong>. Hãy truy cập trang Quản trị để quản lý hệ thống.
        </div>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-dark btn-sm px-3">Vào Bảng điều khiển Admin</a>
    </div>
}
else
{
    <!-- ======================================================== -->
    <!-- 1. GÓI TẬP ĐÃ ĐĂNG KÝ (THEO GIAO DIỆN MODULE 3) -->
    <!-- ======================================================== -->
    <div class="mt-3 mb-5" id="section-registered">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="mb-0">Gói tập đã đăng ký</h2>
            <a href="#section-packages" class="btn btn-primary">+ Đăng ký gói tập</a>
        </div>

        <div class="alert alert-primary bg-primary bg-opacity-10 border-primary border-opacity-25 shadow-sm mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div>
                <span class="fs-5 fw-bold text-primary">@hoTenHienThi</span>
                @if (!string.IsNullOrEmpty(Model.HoiVien?.MaHoiVien))
                {
                    <span class="badge bg-primary ms-2">Mã: @Model.HoiVien.MaHoiVien</span>
                }
            </div>
            <div class="text-muted small">
                Chỉ hiển thị các gói tập thuộc quyền tài khoản của bạn
            </div>
        </div>

        <div class="table-responsive shadow-sm rounded-3 bg-white">
            <table class="table table-bordered table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Mã phiếu</th>
                        <th>Hội viên</th>
                        <th>Gói tập</th>
                        <th>Tổng tiền</th>
                        <th>Ngày đăng ký</th>
                        <th>Ngày bắt đầu</th>
                        <th>Ngày kết thúc</th>
                        <th>Trạng thái</th>
                        <th class="text-center" style="width: 170px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.DanhSachPhieuDangKy != null && Model.DanhSachPhieuDangKy.Any())
                    {
                        @foreach (var item in Model.DanhSachPhieuDangKy)
                        {
                            bool isExpired = (item.TrangThai == TrangThaiPhieu.DangHieuLuc || item.TrangThai == "Đã xác nhận")
                                && DateTime.Today > item.NgayKetThuc.Date;

                            <tr>
                                <td class="fw-bold">@item.MaPhieu</td>
                                <td>
                                    <strong>@(item.HoiVien?.HoTen ?? hoTenHienThi)</strong>
                                    <small class="d-block text-muted">Mã: @item.MaHoiVien</small>
                                </td>
                                <td>
                                    <span>@(item.GoiTap?.TenGoiTap ?? item.MaGoiTap)</span>
                                    <small class="d-block text-muted">Mã: @item.MaGoiTap</small>
                                </td>
                                <td class="text-primary fw-bold">
                                    @((item.TongTien > 0 ? item.TongTien : item.DonGia).ToString("N0")) đ
                                </td>
                                <td>@item.NgayDangKy.ToString("dd/MM/yyyy")</td>
                                <td>@item.NgayBatDau.ToString("dd/MM/yyyy")</td>
                                <td>@item.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @if (isExpired)
                                    {
                                        <span class="badge bg-secondary">Hết hạn</span>
                                    }
                                    else if (item.TrangThai == TrangThaiPhieu.DangHieuLuc || item.TrangThai == "Đã xác nhận")
                                    {
                                        <span class="badge bg-success">✔ @item.TrangThai</span>
                                    }
                                    else if (item.TrangThai == TrangThaiPhieu.ChoXacNhan)
                                    {
                                        <span class="badge bg-warning text-dark">⏳ @item.TrangThai</span>
                                    }
                                    else if (item.TrangThai == TrangThaiPhieu.DaHuy)
                                    {
                                        <span class="badge bg-danger">✖ @item.TrangThai</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@item.TrangThai</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-1">
                                        @if (item.TrangThai == TrangThaiPhieu.ChoXacNhan)
                                        {
                                            <form asp-controller="PhieuDangKys" asp-action="Huy" asp-route-id="@item.MaPhieu" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="returnUrl" value="@homeReturnUrl" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm px-2 py-1"
                                                        onclick="return confirm('CẢNH BÁO: Khi hủy gói tập, hệ thống sẽ KHÔNG HOÀN TIỀN! Bạn có chắc chắn muốn hủy phiếu này không?');"
                                                        title="Hủy phiếu (Không hoàn tiền)">
                                                    Hủy
                                                </button>
                                            </form>
                                        }
                                        else if ((item.TrangThai == TrangThaiPhieu.DangHieuLuc || item.TrangThai == "Đã xác nhận") && !isExpired)
                                        {
                                            <form asp-controller="PhieuDangKys" asp-action="GiaHan" asp-route-id="@item.MaPhieu" asp-route-soThang="1" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="returnUrl" value="@homeReturnUrl" />
                                                <button type="submit" class="btn btn-primary btn-sm px-2 py-1"
                                                        onclick="return confirm('Bạn có chắc muốn gia hạn thêm 1 tháng? Phiếu sẽ chuyển sang trạng thái chờ duyệt.');"
                                                        title="Gia hạn thêm 1 tháng (chờ duyệt)">
                                                    +1 Th
                                                </button>
                                            </form>
                                            <form asp-controller="PhieuDangKys" asp-action="Huy" asp-route-id="@item.MaPhieu" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="returnUrl" value="@homeReturnUrl" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm px-2 py-1"
                                                        onclick="return confirm('CẢNH BÁO: Khi hủy gói tập, hệ thống sẽ KHÔNG HOÀN TIỀN! Bạn có chắc chắn muốn hủy phiếu này không?');"
                                                        title="Hủy phiếu (Không hoàn tiền)">
                                                    Hủy
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Đã kết thúc</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                Bạn chưa đăng ký gói tập nào. Hãy chọn gói tập ở danh sách phía dưới để bắt đầu luyện tập.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- ======================================================== -->
<!-- 2. DANH SÁCH GÓI TẬP ĐANG ÁP DỤNG (TÌM KIẾM - LỌC - SẮP XẾP - ĐĂNG KÝ) -->
<!-- ======================================================== -->
<div class="card shadow-sm border-0 rounded-4 mb-4" id="section-packages">
    <div class="card-header bg-white border-0 pt-3 px-4 d-flex flex-wrap justify-content-between align-items-center">
        <div>
            <h5 class="fw-bold mb-0">Danh sách Gói tập đang áp dụng</h5>
            <small class="text-muted">Chọn gói tập phù hợp với mục tiêu luyện tập của bạn</small>
        </div>
        @if (isAuthenticated && !isAdmin)
        {
            <a asp-controller="PhieuDangKys" asp-action="Create" class="btn btn-outline-primary btn-sm">
                Trang đăng ký đầy đủ
            </a>
        }
    </div>
    <div class="card-body px-4 pb-4">
        <div class="row g-2 mb-3">
            <div class="col-md-4">
                <input type="text" id="searchInput" class="form-control" placeholder="Tìm kiếm theo tên gói tập..." oninput="filterAndSortPackages()" />
            </div>
            <div class="col-md-3">
                <select id="categoryFilter" class="form-select" onchange="filterAndSortPackages()">
                    <option value="all">-- Tất cả loại gói --</option>
                    @foreach (var loai in Model.DanhSachLoaiGoi)
                    {
                        <option value="@loai.MaLoaiGoi">@loai.TenLoaiGoi</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select id="sortFilter" class="form-select" onchange="filterAndSortPackages()">
                    <option value="default">-- Sắp xếp: Mặc định --</option>
                    <option value="price-asc">Giá: Thấp đến cao</option>
                    <option value="price-desc">Giá: Cao đến thấp</option>
                    <option value="duration-desc">Thời hạn: Dài nhất</option>
                    <option value="name-asc">Tên gói: A - Z</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="button" class="btn btn-outline-secondary w-100" onclick="resetFilters()">Đặt lại</button>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="packagesTable">
                <thead class="table-light">
                    <tr>
                        <th style="width: 90px;">Mã gói</th>
                        <th>Tên gói tập</th>
                        <th>Loại gói</th>
                        <th style="width: 110px;">Thời hạn</th>
                        <th style="width: 130px;">Số buổi tối đa</th>
                        <th style="width: 130px;">Đơn giá</th>
                        <th style="width: 170px;" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="packagesTableBody">
                    @if (Model.DanhSachGoiTap != null && Model.DanhSachGoiTap.Any())
                    {
                        foreach (var item in Model.DanhSachGoiTap)
                        {
                            var catKey = item.MaLoaiGoi?.ToString() ?? "0";
                            int months = int.TryParse(item.ThoiHanThang, out var m) && m > 0 ? m : 1;

                            <tr class="package-row"
                                data-id="@item.MaGoiTap"
                                data-name="@item.TenGoiTap.ToLower()"
                                data-cat="@catKey"
                                data-price="@((long)item.DonGia)"
                                data-duration="@months">
                                <td class="fw-bold text-secondary">@item.MaGoiTap</td>
                                <td>
                                    <strong>@item.TenGoiTap</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.MoTa))
                                    {
                                        <div class="small text-muted">@item.MoTa</div>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@(item.LoaiGoiTap?.TenLoaiGoi ?? "Tiêu chuẩn")</span>
                                </td>
                                <td>@months tháng</td>
                                <td>@(item.SoBuoiToiDa > 0 ? item.SoBuoiToiDa + " buổi" : "Không giới hạn")</td>
                                <td class="text-danger fw-bold">@item.DonGia.ToString("N0") đ</td>
                                <td class="text-center text-nowrap">
                                    @if (isAuthenticated && !isAdmin)
                                    {
                                        <button type="button" class="btn btn-sm btn-primary btn-open-register"
                                                data-id="@item.MaGoiTap"
                                                data-name="@item.TenGoiTap"
                                                data-price="@((long)item.DonGia)"
                                                data-duration="@months">
                                            Đăng ký
                                        </button>
                                    }
                                    else if (!isAuthenticated)
                                    {
                                        <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-outline-primary">
                                            Đăng ký
                                        </a>
                                    }
                                    <button type="button" class="btn btn-sm btn-outline-secondary btn-open-detail"
                                            data-id="@item.MaGoiTap"
                                            data-name="@item.TenGoiTap"
                                            data-price="@item.DonGia.ToString("N0")"
                                            data-duration="@months"
                                            data-sessions="@item.SoBuoiToiDa"
                                            data-desc="@item.MoTa">
                                        Chi tiết
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">Hiện chưa có gói tập nào đang áp dụng.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (isAuthenticated && !isAdmin)
{
    <!-- ======================================================== -->
    <!-- 3. THÔNG TIN CÁ NHÂN & ĐỔI MẬT KHẨU NHANH -->
    <!-- ======================================================== -->
    <div class="row g-4 mb-4" id="section-profile">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0">Cập nhật thông tin cá nhân</h5>
                    <a asp-controller="HoiViens" asp-action="ThongTinCaNhan" class="small text-decoration-none">Mở trang hồ sơ →</a>
                </div>
                <div class="card-body px-4 pb-4">
                    <form id="formProfile" onsubmit="handleProfileUpdate(event)">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                            <input type="text" id="profHoTen" class="form-control" value="@hoTenHienThi" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                            <input type="email" id="profEmail" class="form-control" value="@(Model.HoiVien?.Email ?? Model.TaiKhoan?.Email)" required />
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Số điện thoại</label>
                                <input type="text" id="profPhone" class="form-control" value="@Model.HoiVien?.SoDienThoai" placeholder="09xxxxxxxx" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Giới tính</label>
                                <select id="profGender" class="form-select">
                                    <option value="Nam" selected="@(Model.HoiVien?.GioiTinh == "Nam")">Nam</option>
                                    <option value="Nữ" selected="@(Model.HoiVien?.GioiTinh == "Nữ")">Nữ</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Ngày sinh</label>
                            <input type="date" id="profDob" class="form-control" value="@(Model.HoiVien?.NgaySinh.ToString("yyyy-MM-dd") ?? "2000-01-01")" />
                        </div>
                        <button type="submit" id="btnSaveProfile" class="btn btn-primary">Lưu thông tin</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card h-100 shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-0 pt-3 px-4">
                    <h5 class="fw-bold mb-0">Đổi mật khẩu</h5>
                </div>
                <div class="card-body px-4 pb-4">
                    <form id="formPassword" onsubmit="handlePasswordChange(event)">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                            <input type="password" id="oldPassword" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Mật khẩu mới (6 - 30 ký tự) <span class="text-danger">*</span></label>
                            <input type="password" id="newPassword" class="form-control" minlength="6" maxlength="30" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                            <input type="password" id="confirmPassword" class="form-control" minlength="6" maxlength="30" required />
                        </div>
                        <button type="submit" id="btnChangePass" class="btn btn-warning fw-semibold">Đổi mật khẩu</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<!-- ======================================================== -->
<!-- MODAL: ĐĂNG KÝ GÓI TẬP -->
<!-- ======================================================== -->
<div class="modal fade" id="registerModal" tabindex="-1" aria-labelledby="registerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-light rounded-top-4">
                <h5 class="modal-title fw-bold" id="registerModalLabel">Đăng ký gói tập</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="formRegister" onsubmit="handleRegisterSubmit(event)">
                <div class="modal-body p-4">
                    <input type="hidden" id="regPackageId" />
                    <input type="hidden" id="regMonths" value="1" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên gói tập</label>
                        <input type="text" id="regPackageName" class="form-control" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Đơn giá thanh toán</label>
                        <input type="text" id="regPriceFormatted" class="form-control fw-bold text-danger" readonly />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Ngày bắt đầu</label>
                            <input type="date" id="regStartDate" class="form-control" required onchange="calculateEndDate()" />
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Ngày kết thúc dự kiến</label>
                            <input type="text" id="regEndDate" class="form-control" readonly />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Phương thức thanh toán</label>
                        <select id="regPayment" class="form-select">
                            <option value="qr">Chuyển khoản VietQR</option>
                            <option value="cash">Thanh toán tại quầy lễ tân</option>
                        </select>
                    </div>

                    <div class="mb-2">
                        <label class="form-label fw-semibold">Ghi chú (Tùy chọn)</label>
                        <input type="text" id="regNote" class="form-control" placeholder="Ghi chú thêm nếu có..." />
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" id="btnSubmitReg" class="btn btn-primary fw-semibold">Xác nhận đăng ký</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ======================================================== -->
<!-- MODAL: CHI TIẾT GÓI TẬP -->
<!-- ======================================================== -->
<div class="modal fade" id="detailModal" tabindex="-1" aria-labelledby="detailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-light rounded-top-4">
                <h5 class="modal-title fw-bold" id="detailModalLabel">Chi tiết gói tập</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Mã gói:</dt>
                    <dd class="col-sm-8" id="dtCode">-</dd>

                    <dt class="col-sm-4">Tên gói:</dt>
                    <dd class="col-sm-8 fw-bold" id="dtTitle">-</dd>

                    <dt class="col-sm-4">Đơn giá:</dt>
                    <dd class="col-sm-8 text-danger fw-bold" id="dtPrice">-</dd>

                    <dt class="col-sm-4">Thời hạn:</dt>
                    <dd class="col-sm-8" id="dtDuration">-</dd>

                    <dt class="col-sm-4">Số buổi tối đa:</dt>
                    <dd class="col-sm-8" id="dtSessions">-</dd>

                    <dt class="col-sm-4">Mô tả:</dt>
                    <dd class="col-sm-8 text-muted" id="dtDesc">-</dd>
                </dl>
            </div>
            <div class="modal-footer bg-light rounded-bottom-4">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function getTodayLocalIso() {
            const now = new Date();
            const y = now.getFullYear();
            const m = String(now.getMonth() + 1).padStart(2, '0');
            const d = String(now.getDate()).padStart(2, '0');
            return `${y}-${m}-${d}`;
        }

        function resetFilters() {
            document.getElementById('searchInput').value = '';
            document.getElementById('categoryFilter').value = 'all';
            document.getElementById('sortFilter').value = 'default';
            filterAndSortPackages();
        }

        function filterAndSortPackages() {
            const search = document.getElementById('searchInput').value.toLowerCase().trim();
            const cat = document.getElementById('categoryFilter').value;
            const sort = document.getElementById('sortFilter').value;

            const tbody = document.getElementById('packagesTableBody');
            const rows = Array.from(tbody.querySelectorAll('.package-row'));

            rows.forEach(row => {
                const name = row.dataset.name || '';
                const rowCat = row.dataset.cat || '';
                const matchSearch = !search || name.includes(search);
                const matchCat = cat === 'all' || rowCat === cat;
                row.style.display = (matchSearch && matchCat) ? '' : 'none';
            });

            rows.sort((a, b) => {
                const priceA = parseFloat(a.dataset.price) || 0;
                const priceB = parseFloat(b.dataset.price) || 0;
                const durA = parseInt(a.dataset.duration) || 0;
                const durB = parseInt(b.dataset.duration) || 0;
                const nameA = a.dataset.name || '';
                const nameB = b.dataset.name || '';

                if (sort === 'price-asc') return priceA - priceB;
                if (sort === 'price-desc') return priceB - priceA;
                if (sort === 'duration-desc') return durB - durA;
                if (sort === 'name-asc') return nameA.localeCompare(nameB);
                return (a.dataset.id || '').localeCompare(b.dataset.id || '');
            });

            rows.forEach(row => tbody.appendChild(row));
        }

        function viewDetail(id, title, price, duration, sessions, desc) {
            document.getElementById('dtCode').textContent = id || '-';
            document.getElementById('dtTitle').textContent = title || '-';
            document.getElementById('dtPrice').textContent = price ? price + ' đ' : '-';
            document.getElementById('dtDuration').textContent = (duration || 1) + ' tháng';
            document.getElementById('dtSessions').textContent = sessions > 0 ? sessions + ' buổi' : 'Không giới hạn';
            document.getElementById('dtDesc').textContent = desc || 'Gói tập tiêu chuẩn với đầy đủ quyền lợi luyện tập.';

            const modalEl = document.getElementById('detailModal');
            bootstrap.Modal.getOrCreateInstance(modalEl).show();
        }

        function openRegisterModal(id, title, price, duration) {
            document.getElementById('regPackageId').value = id;
            document.getElementById('regPackageName').value = title;
            document.getElementById('regPriceFormatted').value = Number(price || 0).toLocaleString('vi-VN') + ' đ';
            document.getElementById('regMonths').value = parseInt(duration) || 1;

            const today = getTodayLocalIso();
            const startInput = document.getElementById('regStartDate');
            startInput.value = today;
            startInput.min = today;

            calculateEndDate();

            const modalEl = document.getElementById('registerModal');
            bootstrap.Modal.getOrCreateInstance(modalEl).show();
        }

        function calculateEndDate() {
            const startVal = document.getElementById('regStartDate').value;
            const months = parseInt(document.getElementById('regMonths').value) || 1;
            if (!startVal) return;

            const parts = startVal.split('-').map(Number);
            const start = new Date(parts[0], parts[1] - 1, parts[2]);
            const end = new Date(start);
            end.setMonth(end.getMonth() + months);

            const dd = String(end.getDate()).padStart(2, '0');
            const mm = String(end.getMonth() + 1).padStart(2, '0');
            const yyyy = end.getFullYear();
            document.getElementById('regEndDate').value = `${dd}/${mm}/${yyyy}`;
        }

        async function submitRegistration(xacNhanGoiKhac) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const formData = new FormData();
            formData.append('MaGoiTap', document.getElementById('regPackageId').value);
            formData.append('NgayBatDau', document.getElementById('regStartDate').value);
            formData.append('GhiChu', document.getElementById('regNote').value);
            formData.append('PhuongThucThanhToan', document.getElementById('regPayment').value);
            formData.append('XacNhanGoiKhac', xacNhanGoiKhac ? 'true' : 'false');
            formData.append('__RequestVerificationToken', token);

            const res = await fetch('/Home/DangKyGoiTap', {
                method: 'POST',
                body: formData
            });
            return await res.json();
        }

        async function handleRegisterSubmit(event) {
            event.preventDefault();
            const btn = document.getElementById('btnSubmitReg');
            btn.disabled = true;

            try {
                let data = await submitRegistration(false);
                if (!data.success && data.needConfirm) {
                    if (confirm(data.message)) {
                        data = await submitRegistration(true);
                    } else {
                        return;
                    }
                }

                if (data.success) {
                    const modalEl = document.getElementById('registerModal');
                    const modal = bootstrap.Modal.getInstance(modalEl);
                    if (modal) modal.hide();

                    alert(data.message);
                    window.location.reload();
                } else {
                    alert(data.message || 'Đăng ký không thành công.');
                }
            } catch (err) {
                alert('Lỗi: ' + err.message);
            } finally {
                btn.disabled = false;
            }
        }

        async function handleProfileUpdate(event) {
            event.preventDefault();
            const btn = document.getElementById('btnSaveProfile');
            btn.disabled = true;

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const formData = new FormData();
                formData.append('HoTen', document.getElementById('profHoTen').value);
                formData.append('Email', document.getElementById('profEmail').value);
                formData.append('SoDienThoai', document.getElementById('profPhone').value);
                formData.append('NgaySinh', document.getElementById('profDob').value);
                formData.append('GioiTinh', document.getElementById('profGender').value);
                formData.append('__RequestVerificationToken', token);

                const res = await fetch('/Home/CapNhatThongTin', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                alert(data.message);
                if (data.success) window.location.reload();
            } catch (err) {
                alert('Lỗi: ' + err.message);
            } finally {
                btn.disabled = false;
            }
        }

        async function handlePasswordChange(event) {
            event.preventDefault();
            const newPass = document.getElementById('newPassword').value;
            const confirmPass = document.getElementById('confirmPassword').value;
            if (newPass !== confirmPass) {
                alert('Xác nhận mật khẩu mới không khớp!');
                return;
            }

            const btn = document.getElementById('btnChangePass');
            btn.disabled = true;

            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                const formData = new FormData();
                formData.append('MatKhauCu', document.getElementById('oldPassword').value);
                formData.append('MatKhauMoi', newPass);
                formData.append('XacNhanMatKhauMoi', confirmPass);
                formData.append('__RequestVerificationToken', token);

                const res = await fetch('/Home/DoiMatKhau', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();
                alert(data.message);
                if (data.success) document.getElementById('formPassword').reset();
            } catch (err) {
                alert('Lỗi: ' + err.message);
            } finally {
                btn.disabled = false;
            }
        }

        document.addEventListener('click', function (e) {
            const regBtn = e.target.closest('.btn-open-register');
            if (regBtn) {
                openRegisterModal(regBtn.dataset.id, regBtn.dataset.name, parseFloat(regBtn.dataset.price) || 0, regBtn.dataset.duration);
                return;
            }

            const dtBtn = e.target.closest('.btn-open-detail');
            if (dtBtn) {
                viewDetail(dtBtn.dataset.id, dtBtn.dataset.name, dtBtn.dataset.price, dtBtn.dataset.duration, dtBtn.dataset.sessions, dtBtn.dataset.desc);
            }
        });
    </script>
}

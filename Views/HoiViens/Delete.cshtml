@model QuanLyPhongTap_UNETI01_TI17A1HN.Models.HoiVien

@{
    ViewData["Title"] = "Xóa hội viên";
    bool canDelete = ViewBag.CanDelete ?? true;
    bool hasActivePackage = ViewBag.HasActivePackage ?? false;
    var activePackages = ViewBag.ActivePackages as List<QuanLyPhongTap_UNETI01_TI17A1HN.Models.PhieuDangKy> ?? new List<QuanLyPhongTap_UNETI01_TI17A1HN.Models.PhieuDangKy>();
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-danger text-white">

            <h4 class="mb-0">
                Xóa hội viên
            </h4>

        </div>

        <div class="card-body">

            @if (hasActivePackage)
            {
                <div class="alert alert-danger" role="alert">
                    <h5 class="alert-heading mb-2">
                        <i class="bi bi-exclamation-triangle-fill"></i> Cảnh báo: Hội viên còn thời gian tập!
                    </h5>
                    <p class="mb-2">
                        Hội viên <strong>@Model.HoTen</strong> (Mã HV: <code>@Model.MaHoiVien</code>) hiện <strong>còn thời gian tập</strong> với <strong>@activePackages.Count</strong> gói tập đang có hiệu lực.
                        Hệ thống <strong>không cho phép xóa</strong> hội viên này khi gói tập vẫn còn hạn!
                    </p>
                    <hr />
                    <h6 class="fw-bold mb-2">Các gói tập còn thời gian tập:</h6>
                    <ul class="mb-0 ps-3">
                        @foreach (var pkg in activePackages)
                        {
                            <li>
                                <strong>@(pkg.GoiTap?.TenGoiTap ?? pkg.MaGoiTap)</strong> - 
                                Hiệu lực: từ <strong>@pkg.NgayBatDau.ToString("dd/MM/yyyy")</strong> đến <strong>@pkg.NgayKetThuc.ToString("dd/MM/yyyy")</strong>
                                <span class="badge bg-success ms-1">@pkg.TrangThai</span>
                            </li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    <strong>Cảnh báo!</strong> Bạn có chắc chắn muốn xóa hội viên này không? Hành động này không thể hoàn tác!
                </div>
            }

            <dl class="row">

                <dt class="col-sm-3">
                    Mã hội viên
                </dt>

                <dd class="col-sm-9">
                    @Model.MaHoiVien
                </dd>


                <dt class="col-sm-3">
                    Họ tên
                </dt>

                <dd class="col-sm-9">
                    @Model.HoTen
                </dd>


                <dt class="col-sm-3">
                    Email
                </dt>

                <dd class="col-sm-9">
                    @Model.Email
                </dd>


                <dt class="col-sm-3">
                    Số điện thoại
                </dt>

                <dd class="col-sm-9">
                    @Model.SoDienThoai
                </dd>


                <dt class="col-sm-3">
                    Trạng thái
                </dt>

                <dd class="col-sm-9">
                    @Model.TrangThai
                </dd>

            </dl>


            @if (canDelete)
            {
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MaHoiVien" />
                    <button type="submit" class="btn btn-danger">
                        Xác nhận xóa
                    </button>
                    <a asp-action="Index" class="btn btn-secondary ms-1">
                        Hủy
                    </a>
                </form>
            }
            else
            {
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-danger" disabled title="Hội viên còn thời gian tập - không thể xóa!">
                        Xác nhận xóa
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        Quay lại danh sách
                    </a>
                </div>
            }

        </div>

    </div>

</div>

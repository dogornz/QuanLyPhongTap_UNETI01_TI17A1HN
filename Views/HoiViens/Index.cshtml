@model IEnumerable<QuanLyPhongTap_UNETI01_TI17A1HN.Models.HoiVien>

@{
    ViewData["Title"] = "Quản lý hội viên";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold">Quản lý hội viên</h2>
            <p class="text-muted">
                Danh sách hội viên phòng tập
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            + Thêm hội viên
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <!-- TÌM KIẾM & LỌC -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Index"
                  method="get">

                <div class="row g-2 align-items-end">

                    <div class="col-md-5">
                        <label class="form-label small fw-semibold">Từ khóa</label>
                        <input type="text"
                               name="keyword"
                               value="@ViewBag.Keyword"
                               class="form-control"
                               placeholder="Tìm theo mã hội viên, họ tên, email, số điện thoại..." />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label small fw-semibold">Trạng thái</label>
                        <select name="trangThai" class="form-select">
                            <option value="">-- Tất cả trạng thái --</option>
                            <option value="Đang hoạt động" selected="@(ViewBag.TrangThai == "Đang hoạt động")">Đang hoạt động</option>
                            <option value="Ngừng hoạt động" selected="@(ViewBag.TrangThai == "Ngừng hoạt động")">Ngừng hoạt động</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label small fw-semibold">Giới tính</label>
                        <select name="gioiTinh" class="form-select">
                            <option value="">-- Tất cả --</option>
                            <option value="Nam" selected="@(ViewBag.GioiTinh == "Nam")">Nam</option>
                            <option value="Nữ" selected="@(ViewBag.GioiTinh == "Nữ")">Nữ</option>
                        </select>
                    </div>

                    <div class="col-md-2 d-flex gap-1">
                        <button type="submit"
                                class="btn btn-primary flex-grow-1">
                            🔍 Lọc
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc">
                            Xóa lọc
                        </a>
                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- DANH SÁCH -->

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">
                Danh sách hội viên
            </h5>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-bordered table-hover mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>STT</th>
                            <th>Mã HV</th>
                            <th>Họ tên</th>
                            <th>Ngày sinh</th>
                            <th>Email</th>
                            <th>Số điện thoại</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            int stt = 1;

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td>
                                        @stt
                                    </td>

                                    <td>
                                        @item.MaHoiVien
                                    </td>

                                    <td>
                                        @item.HoTen
                                    </td>

                                    <td>
                                        @item.NgaySinh.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @item.Email
                                    </td>

                                    <td>
                                        @item.SoDienThoai
                                    </td>

                                    <td>

                                        @if (item.TrangThai == "Đang hoạt động")
                                        {
                                            <span class="badge bg-success">
                                                Đang hoạt động
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Ngừng hoạt động
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <div class="d-flex gap-1">

                                            <a asp-action="Details"
                                               asp-route-id="@item.MaHoiVien"
                                               class="btn btn-info btn-sm">
                                                Xem
                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.MaHoiVien"
                                               class="btn btn-warning btn-sm">
                                                Sửa
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.MaHoiVien"
                                               class="btn btn-danger btn-sm">
                                                Xóa
                                            </a>

                                        </div>

                                    </td>

                                </tr>

                                stt++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    Không tìm thấy hội viên nào phù hợp.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
@model IEnumerable<QuanLyPhongTap_UNETI01_TI17A1HN.Models.PhieuDangKy>

@{
    ViewData["Title"] = "Các gói đã đăng ký";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Gói tập đã đăng ký</h2>

        <a asp-action="Create" class="btn btn-primary">
            + Đăng ký gói tập
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
        </div>
    }

    <div class="card mb-3 shadow-sm border-0">
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="row g-2">
                    <div class="col-md-9">
                        <select name="maHoiVien"
                                class="form-select"
                                asp-items="ViewBag.HoiViens">
                            <option value="">-- Tất cả hội viên --</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <button type="submit"
                                class="btn btn-outline-primary w-100">
                            🔍 Lọc hội viên
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive shadow-sm rounded-3">
        <table class="table table-bordered table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Mã phiếu</th>
                    <th>Hội viên</th>
                    <th>Gói tập</th>
                    <th>Tổng tiền</th>
                    <th>Ngày đăng ký</th>
                    <th>Ngày bắt đầu</th>
                    <th>Ngày kết thúc</th>
                    <th>Trạng thái</th>
                    <th class="text-center" style="width: 180px;">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.MaPhieu</td>
                            <td>
                                <strong>@item.HoiVien?.HoTen</strong>
                                <small class="d-block text-muted">
                                    Mã: @item.MaHoiVien
                                </small>
                            </td>
                            <td>
                                <span>@item.GoiTap?.TenGoiTap</span>
                                <small class="d-block text-muted">
                                    Mã: @item.MaGoiTap
                                </small>
                            </td>
                            <td class="text-primary fw-bold">
                                @((item.TongTien > 0 ? item.TongTien : item.DonGia).ToString("N0")) đ
                            </td>
                            <td>@item.NgayDangKy.ToString("dd/MM/yyyy")</td>
                            <td>@item.NgayBatDau.ToString("dd/MM/yyyy")</td>
                            <td>@item.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.TrangThai == "Đang hiệu lực" || item.TrangThai == "Đã xác nhận")
                                {
                                    <span class="badge bg-success">
                                        ✔ @item.TrangThai
                                    </span>
                                }
                                else if (item.TrangThai == "Chờ xác nhận")
                                {
                                    <span class="badge bg-warning text-dark">
                                        ⏳ @item.TrangThai
                                    </span>
                                }
                                else if (item.TrangThai == "Đã hủy")
                                {
                                    <span class="badge bg-danger">
                                        ✖ @item.TrangThai
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @item.TrangThai
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-1">
                                    @if (item.TrangThai == "Chờ xác nhận")
                                    {
                                        <form asp-action="XacNhan" asp-route-id="@item.MaPhieu" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success btn-sm px-2 py-1" title="Kích hoạt phiếu">
                                                Duyệt
                                            </button>
                                        </form>
                                        <form asp-action="Huy" asp-route-id="@item.MaPhieu" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm px-2 py-1" onclick="return confirm('Bạn có chắc muốn hủy phiếu này?');" title="Hủy phiếu">
                                                Hủy
                                            </button>
                                        </form>
                                    }
                                    else if (item.TrangThai == "Đang hiệu lực" || item.TrangThai == "Đã xác nhận")
                                    {
                                        <form asp-action="GiaHan" asp-route-id="@item.MaPhieu" asp-route-soThang="1" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-primary btn-sm px-2 py-1" title="Gia hạn thêm 1 tháng">
                                                +1 Th
                                            </button>
                                        </form>
                                        <form asp-action="Huy" asp-route-id="@item.MaPhieu" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm px-2 py-1" onclick="return confirm('Bạn có chắc muốn hủy phiếu này?');" title="Hủy phiếu">
                                                Hủy
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Đã kết thúc</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">
                            Chưa có phiếu đăng ký nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

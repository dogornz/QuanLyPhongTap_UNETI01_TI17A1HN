@model QuanLyPhongTap_UNETI01_TI17A1HN.Models.GoiTap

@{
    ViewData["Title"] = "Xóa Gói tập";
    bool canDelete = ViewBag.CanDelete ?? true;
    int relatedTickets = ViewBag.RelatedTickets ?? 0;
}

<h1>Xóa</h1>

@if (!canDelete)
{
    <div class="alert alert-danger" role="alert">
        <h5 class="alert-heading mb-1"><i class="bi bi-exclamation-triangle-fill"></i> Không thể xóa gói tập!</h5>
        <p class="mb-0">
            Gói tập <strong>@Model.TenGoiTap</strong> (<code>@Model.MaGoiTap</code>) hiện đang có <strong>@relatedTickets</strong> phiếu đăng ký liên quan.
            Theo quy định toàn vẹn dữ liệu, bạn không thể xóa gói tập này. Bạn có thể chọn chuyển trạng thái sang <strong>Ngừng áp dụng</strong>.
        </p>
    </div>
}
else
{
    <div class="alert alert-warning" role="alert">
        Bạn có chắc chắn muốn xóa gói tập này khỏi hệ thống không? Hành động này không thể hoàn tác!
    </div>
}

<div>
    <h4>Gói tập: @Model.TenGoiTap</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Mã gói tập:</dt>
        <dd class="col-sm-9"><code>@Model.MaGoiTap</code></dd>

        <dt class="col-sm-3">Tên gói tập:</dt>
        <dd class="col-sm-9 fw-bold">@Model.TenGoiTap</dd>

        <dt class="col-sm-3">Loại gói tập:</dt>
        <dd class="col-sm-9">@(Model.LoaiGoiTap?.TenLoaiGoi ?? "Chưa phân loại")</dd>

        <dt class="col-sm-3">Thời hạn:</dt>
        <dd class="col-sm-9">@(Model.ThoiHanThang ?? "1") tháng</dd>

        <dt class="col-sm-3">Đơn giá:</dt>
        <dd class="col-sm-9 text-danger fw-bold">@Model.DonGia.ToString("N0") VNĐ</dd>

        <dt class="col-sm-3">Trạng thái:</dt>
        <dd class="col-sm-9">@Model.TrangThai</dd>
    </dl>

    @if (canDelete)
    {
        <form asp-action="Delete">
            <input type="hidden" asp-for="MaGoiTap" />
            <input type="submit" value="Xác nhận Xóa" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-outline-secondary">Hủy bỏ</a>
        </form>
    }
    else
    {
        <div>
            <a asp-action="ChangeStatus" asp-route-id="@Model.MaGoiTap" class="btn btn-warning">Chuyển sang Ngừng áp dụng</a>
            <a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>
        </div>
    }
</div>

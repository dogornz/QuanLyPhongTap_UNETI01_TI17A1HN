@model QuanLyPhongTap_UNETI01_TI17A1HN.ViewModels.GoiTapIndexViewModel

@{
    ViewData["Title"] = "Quản lý Gói tập";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0">Quản lý Gói tập</h1>
        <p class="text-muted small mb-0">Danh sách các gói tập luyện trong hệ thống phòng tập</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        + Thêm gói tập mới
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Bộ lọc, Tìm kiếm & Sắp xếp -->
<div class="card mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get">
            <div class="row g-2">
                <!-- 6.3. Tìm kiếm theo Tên gói tập -->
                <div class="col-md-4">
                    <label class="form-label fw-bold small">Tìm kiếm theo Tên gói</label>
                    <input type="text" name="searchName" class="form-control" placeholder="Nhập tên gói tập..." value="@Model.SearchName" />
                </div>

                <!-- 6.4. Lọc Loại gói -->
                <div class="col-md-4">
                    <label class="form-label fw-bold small">Loại gói tập</label>
                    <select name="maLoaiGoi" class="form-select">
                        <option value="">-- Tất cả loại gói --</option>
                        @if (Model.LoaiGoiList != null)
                        {
                            foreach (var l in Model.LoaiGoiList)
                            {
                                <option value="@l.MaLoaiGoi" selected="@(Model.MaLoaiGoi == l.MaLoaiGoi)">@l.TenLoaiGoi</option>
                            }
                        }
                    </select>
                </div>

                <!-- 6.4. Lọc Trạng thái -->
                <div class="col-md-4">
                    <label class="form-label fw-bold small">Trạng thái</label>
                    <select name="trangThai" class="form-select">
                        <option value="all">-- Tất cả trạng thái --</option>
                        <option value="Đang áp dụng" selected="@(Model.TrangThai == "Đang áp dụng")">Đang áp dụng</option>
                        <option value="Tạm ngừng" selected="@(Model.TrangThai == "Tạm ngừng")">Tạm ngừng</option>
                        <option value="Ngừng áp dụng" selected="@(Model.TrangThai == "Ngừng áp dụng")">Ngừng áp dụng</option>
                    </select>
                </div>

                <!-- 6.4. Lọc Khoảng đơn giá (Giá từ - Giá đến) -->
                <div class="col-md-3">
                    <label class="form-label fw-bold small">Đơn giá từ (VNĐ)</label>
                    <input type="number" name="giaTu" class="form-control" placeholder="0" min="0" step="50000" value="@Model.GiaTu" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold small">Đơn giá đến (VNĐ)</label>
                    <input type="number" name="giaDen" class="form-control" placeholder="Không giới hạn" min="0" step="50000" value="@Model.GiaDen" />
                </div>

                <!-- 6.4. Lọc Thời hạn -->
                <div class="col-md-3">
                    <label class="form-label fw-bold small">Thời hạn</label>
                    <select name="thoiHan" class="form-select">
                        <option value="all">-- Tất cả thời hạn --</option>
                        @if (Model.ThoiHanList != null)
                        {
                            foreach (var th in Model.ThoiHanList)
                            {
                                <option value="@th" selected="@(Model.ThoiHan == th)">@th tháng</option>
                            }
                        }
                    </select>
                </div>

                <!-- 6.5. Sắp xếp -->
                <div class="col-md-3">
                    <label class="form-label fw-bold small">Sắp xếp theo</label>
                    <select name="sortOrder" class="form-select">
                        <option value="ten_asc" selected="@(Model.SortOrder == "ten_asc")">Tên gói A → Z</option>
                        <option value="ten_desc" selected="@(Model.SortOrder == "ten_desc")">Tên gói Z → A</option>
                        <option value="gia_asc" selected="@(Model.SortOrder == "gia_asc")">Đơn giá tăng dần</option>
                        <option value="gia_desc" selected="@(Model.SortOrder == "gia_desc")">Đơn giá giảm dần</option>
                        <option value="thoihan_asc" selected="@(Model.SortOrder == "thoihan_asc")">Thời hạn tăng dần</option>
                        <option value="thoihan_desc" selected="@(Model.SortOrder == "thoihan_desc")">Thời hạn giảm dần</option>
                    </select>
                </div>

                <div class="col-12 d-flex justify-content-end gap-2 mt-3">
                    <button type="submit" class="btn btn-primary">Tìm kiếm & Lọc</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Đặt lại</a>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- 6.6. Bảng danh sách hiển thị dữ liệu -->
<div class="table-responsive">
    <table class="table table-bordered table-striped align-middle">
        <thead class="table-light">
            <tr>
                <th style="width: 90px;">Mã gói</th>
                <th>Tên gói tập</th>
                <th>Loại gói</th>
                <th style="width: 100px;">Thời hạn</th>
                <th style="width: 120px;">Số buổi tối đa</th>
                <th style="width: 130px;">Đơn giá</th>
                <th style="width: 130px;">Trạng thái</th>
                <th style="width: 220px;" class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Items != null && Model.Items.Any())
            {
                foreach (var item in Model.Items)
                {
                    <tr>
                        <td><code>@item.MaGoiTap</code></td>
                        <td>
                            <strong>@item.TenGoiTap</strong>
                            @if (!string.IsNullOrWhiteSpace(item.MoTa))
                            {
                                <div class="small text-muted text-truncate" style="max-width: 280px;">@item.MoTa</div>
                            }
                        </td>
                        <!-- Danh sách hiển thị Tên loại gói, không chỉ MaLoaiGoi -->
                        <td>
                            @(item.LoaiGoiTap?.TenLoaiGoi ?? "Chưa phân loại")
                        </td>
                        <td>@(item.ThoiHanThang) tháng</td>
                        <td>@(item.SoBuoiToiDa > 0 ? item.SoBuoiToiDa + " buổi" : "Không giới hạn")</td>
                        <td class="text-danger fw-bold">@item.DonGia.ToString("N0") đ</td>
                        <td>
                            @if (item.TrangThai == "Đang áp dụng")
                            {
                                <span class="badge bg-success">@item.TrangThai</span>
                            }
                            else if (item.TrangThai == "Tạm ngừng")
                            {
                                <span class="badge bg-warning text-dark">@item.TrangThai</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@item.TrangThai</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.MaGoiTap" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <a asp-action="Details" asp-route-id="@item.MaGoiTap" class="btn btn-sm btn-outline-info">Chi tiết</a>
                            <a asp-action="Delete" asp-route-id="@item.MaGoiTap" class="btn btn-sm btn-outline-danger">Xóa</a>
                            <a asp-action="ChangeStatus" asp-route-id="@item.MaGoiTap" class="btn btn-sm btn-outline-warning" title="Đổi trạng thái">Đổi TT</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="8" class="text-center text-muted py-4">
                        Không tìm thấy gói tập nào phù hợp điều kiện tìm kiếm và lọc.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- 6.6. Phân trang: Trang trước, Trang sau, Các số trang, Hiển thị trang hiện tại, Xử lý đúng trang đầu/trang cuối -->
@if (Model.TotalPages > 0)
{
    <div class="d-flex flex-wrap justify-content-between align-items-center mt-3">
        <div class="small text-muted mb-2 mb-md-0">
            Hiển thị trang <strong>@Model.CurrentPage</strong> / <strong>@Model.TotalPages</strong> (Tổng cộng <strong>@Model.TotalItems</strong> gói tập)
        </div>

        <nav aria-label="Page navigation">
            <ul class="pagination pagination-sm mb-0">
                <!-- Trang đầu -->
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="1"
                       asp-route-searchName="@Model.SearchName"
                       asp-route-maLoaiGoi="@Model.MaLoaiGoi"
                       asp-route-trangThai="@Model.TrangThai"
                       asp-route-giaTu="@Model.GiaTu"
                       asp-route-giaDen="@Model.GiaDen"
                       asp-route-thoiHan="@Model.ThoiHan"
                       asp-route-sortOrder="@Model.SortOrder">Đầu</a>
                </li>

                <!-- Trang trước -->
                <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(Model.CurrentPage - 1)"
                       asp-route-searchName="@Model.SearchName"
                       asp-route-maLoaiGoi="@Model.MaLoaiGoi"
                       asp-route-trangThai="@Model.TrangThai"
                       asp-route-giaTu="@Model.GiaTu"
                       asp-route-giaDen="@Model.GiaDen"
                       asp-route-thoiHan="@Model.ThoiHan"
                       asp-route-sortOrder="@Model.SortOrder">Trang trước</a>
                </li>

                <!-- Các số trang -->
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-page="@i"
                           asp-route-searchName="@Model.SearchName"
                           asp-route-maLoaiGoi="@Model.MaLoaiGoi"
                           asp-route-trangThai="@Model.TrangThai"
                           asp-route-giaTu="@Model.GiaTu"
                           asp-route-giaDen="@Model.GiaDen"
                           asp-route-thoiHan="@Model.ThoiHan"
                           asp-route-sortOrder="@Model.SortOrder">@i</a>
                    </li>
                }

                <!-- Trang sau -->
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@(Model.CurrentPage + 1)"
                       asp-route-searchName="@Model.SearchName"
                       asp-route-maLoaiGoi="@Model.MaLoaiGoi"
                       asp-route-trangThai="@Model.TrangThai"
                       asp-route-giaTu="@Model.GiaTu"
                       asp-route-giaDen="@Model.GiaDen"
                       asp-route-thoiHan="@Model.ThoiHan"
                       asp-route-sortOrder="@Model.SortOrder">Trang sau</a>
                </li>

                <!-- Trang cuối -->
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-page="@Model.TotalPages"
                       asp-route-searchName="@Model.SearchName"
                       asp-route-maLoaiGoi="@Model.MaLoaiGoi"
                       asp-route-trangThai="@Model.TrangThai"
                       asp-route-giaTu="@Model.GiaTu"
                       asp-route-giaDen="@Model.GiaDen"
                       asp-route-thoiHan="@Model.ThoiHan"
                       asp-route-sortOrder="@Model.SortOrder">Cuối</a>
                </li>
            </ul>
        </nav>
    </div>
}

<div class="mt-3">
    <a asp-controller="Admin" asp-action="Index" class="btn btn-secondary">Quay lại Bảng điều khiển</a>
</div>

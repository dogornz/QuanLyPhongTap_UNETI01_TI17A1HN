@{
    ViewData["Title"] = "Từ chối truy cập";
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-12 col-md-8 col-lg-6 text-center">
        <div class="card shadow-sm border-0 rounded-4 p-5 bg-white">
            <div class="display-1 text-warning mb-3">⛔</div>
            <h2 class="fw-bold text-danger mb-3">Truy Cập Bị Từ Chối</h2>
            <p class="text-muted fs-5 mb-4">
                Bạn không có quyền truy cập vào trang này. Chức năng này chỉ dành cho tài khoản có quyền Quản trị viên (Admin).
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary px-4 py-2">
                    Về Trang Chủ
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary px-4 py-2">
                    Đổi Tài Khoản Khác
                </a>
            </div>
        </div>
    </div>
</div>

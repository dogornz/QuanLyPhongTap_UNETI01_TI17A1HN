@model QuanLyPhongTap_UNETI01_TI17A1HN.Models.HoiVien

@{
    ViewData["Title"] = "Thông tin hội viên";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-info text-white">

            <h4 class="mb-0">
                Thông tin hội viên
            </h4>

        </div>

        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-3 fw-bold">
                    Mã hội viên
                </div>

                <div class="col-md-9">
                    @Model.MaHoiVien
                </div>

            </div>


            <div class="row mb-3">

                <div class="col-md-3 fw-bold">
                    Họ tên
                </div>

                <div class="col-md-9">
                    @Model.HoTen
                </div>

            </div>


            <div class="row mb-3">

                <div class="col-md-3 fw-bold">
                    Ngày sinh
                </div>

                <div class="col-md-9">
                    @Model.NgaySinh.ToString("dd/MM/yyyy")
                </div>

            </div>


            <div class="row mb-3">

                <div class="col-md-3 fw-bold">
                    Email
                </div>

                <div class="col-md-9">
                    @Model.Email
                </div>

            </div>


            <div class="row mb-3">

                <div class="col-md-3 fw-bold">
                    Số điện thoại
                </div>

                <div class="col-md-9">
                    @Model.SoDienThoai
                </div>

            </div>


            <div class="row mb-4">

                <div class="col-md-3 fw-bold">
                    Trạng thái
                </div>

                <div class="col-md-9">

                    @if (Model.TrangThai == "Đang hoạt động")
                    {
                        <span class="badge bg-success">
                            Đang hoạt động
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger">
                            Ngừng hoạt động
                        </span>
                    }

                </div>

            </div>


            <div class="d-flex gap-2">

                <a asp-action="Edit"
                   asp-route-id="@Model.MaHoiVien"
                   class="btn btn-warning">
                    Sửa
                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Quay lại
                </a>

            </div>

        </div>

    </div>

</div>
@model QuanLyPhongTap_UNETI01_TI17A1HN.Models.HoiVien

@{
    ViewData["Title"] = "Thêm hội viên";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                Thêm hội viên
            </h4>
        </div>

        <div class="card-body">

            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- MÃ HỘI VIÊN -->

                <div class="mb-3">

                    <label asp-for="MaHoiVien"
                           class="form-label">
                        Mã hội viên
                    </label>

                    <input asp-for="MaHoiVien"
                           class="form-control"
                           placeholder="Nhập mã hội viên" />

                    <span asp-validation-for="MaHoiVien"
                          class="text-danger">
                    </span>

                </div>


                <!-- HỌ TÊN -->

                <div class="mb-3">

                    <label asp-for="HoTen"
                           class="form-label">
                        Họ tên
                    </label>

                    <input asp-for="HoTen"
                           class="form-control"
                           placeholder="Nhập họ tên" />

                    <span asp-validation-for="HoTen"
                          class="text-danger">
                    </span>

                </div>


                <!-- NGÀY SINH -->

                <div class="mb-3">

                    <label asp-for="NgaySinh"
                           class="form-label">
                        Ngày sinh
                    </label>

                    <input asp-for="NgaySinh"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="NgaySinh"
                          class="text-danger">
                    </span>

                </div>


                <!-- EMAIL -->

                <div class="mb-3">

                    <label asp-for="Email"
                           class="form-label">
                        Email
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="example@gmail.com" />

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>


                <!-- SỐ ĐIỆN THOẠI -->

                <div class="mb-3">

                    <label asp-for="SoDienThoai"
                           class="form-label">
                        Số điện thoại
                    </label>

                    <input asp-for="SoDienThoai"
                           class="form-control"
                           placeholder="Nhập số điện thoại" />

                    <span asp-validation-for="SoDienThoai"
                          class="text-danger">
                    </span>

                </div>


                <!-- TRẠNG THÁI -->

                <div class="mb-3">

                    <label asp-for="TrangThai"
                           class="form-label">
                        Trạng thái
                    </label>

                    <select asp-for="TrangThai"
                            class="form-select">

                        <option value="Đang hoạt động">
                            Đang hoạt động
                        </option>

                        <option value="Ngừng hoạt động">
                            Ngừng hoạt động
                        </option>

                    </select>

                </div>


                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Lưu
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Quay lại
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
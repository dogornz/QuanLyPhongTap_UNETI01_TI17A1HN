@model IEnumerable<QuanLyPhongTap_UNETI01_TI17A1HN.Models.PhieuDangKy>

@{
    ViewData["Title"] = "Các gói đã đăng ký";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Gói tập đã đăng ký</h2>

        <a asp-action="Create" class="btn btn-primary">
            + Đăng ký gói tập
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <form asp-action="Index" method="get">
                <div class="row g-2">
                    <div class="col-md-9">
                        <select name="maHoiVien"
                                class="form-select"
                                asp-items="ViewBag.HoiViens">
                            <option value="">-- Tất cả hội viên --</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <button type="submit"
                                class="btn btn-outline-primary w-100">
                            Lọc hội viên
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Mã phiếu</th>
                    <th>Hội viên</th>
                    <th>Gói tập</th>
                    <th>Đơn giá</th>
                    <th>Ngày đăng ký</th>
                    <th>Ngày bắt đầu</th>
                    <th>Ngày kết thúc</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.MaPhieu</td>
                            <td>
                                @item.HoiVien?.HoTen
                                <small class="d-block text-muted">
                                    @item.MaHoiVien
                                </small>
                            </td>
                            <td>
                                @item.GoiTap?.TenGoiTap
                                <small class="d-block text-muted">
                                    @item.MaGoiTap
                                </small>
                            </td>
                            <td>
                                @(item.GoiTap?.DonGia.ToString("N0") ?? "—")
                            </td>
                            <td>@item.NgayDangKy.ToString("dd/MM/yyyy")</td>
                            <td>@item.NgayBatDau.ToString("dd/MM/yyyy")</td>
                            <td>@item.NgayKetThuc.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.TrangThai == "Đã xác nhận")
                                {
                                    <span class="badge bg-success">
                                        @item.TrangThai
                                    </span>
                                }
                                else if (item.TrangThai == "Chờ xác nhận")
                                {
                                    <span class="badge bg-warning text-dark">
                                        @item.TrangThai
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @item.TrangThai
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            Chưa có phiếu đăng ký nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
